<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <!-- Requisito: Nombre del estudiante y versión -->
    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sayuri Morales. v0.1.0 (1)"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnManageCategories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gestionar Categorías (HU-01)"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnManageTasks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gestionar Tareas (HU-02)" />

</LinearLayout>