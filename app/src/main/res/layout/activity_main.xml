<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_academic">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Academic Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            app:cardBackgroundColor="@color/primary_academic"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mi Tiempo Semanal"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Gestión de Planificación Académica"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#33FFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvHeader"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Sayuri Morales"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="v0.4.0"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Panel de Control"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Button Manage Categories -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManageCategories"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="14dp"
            android:text="Gestionar Categorías"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/surface_academic"
            app:cornerRadius="12dp"
            app:icon="@android:drawable/ic_menu_agenda"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@color/primary_academic"
            app:strokeColor="@color/divider_color"
            app:strokeWidth="1dp"
            android:textColor="@color/text_primary" />

        <!-- Button Manage Tasks -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManageTasks"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="14dp"
            android:text="Gestionar Tareas"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary_academic"
            app:cornerRadius="12dp"
            app:icon="@android:drawable/ic_menu_today"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@color/white"
            android:textColor="@color/white" />

        <!-- Button Manage Events (Sprint 2) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManageEvents"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="14dp"
            android:text="Control de Eventos y Tiempos"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/secondary_academic"
            app:cornerRadius="12dp"
            app:icon="@android:drawable/ic_menu_recent_history"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@color/white"
            android:textColor="@color/white" />

        <!-- Button Manage Reports (Sprint 4) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManageReports"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Reportes"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary_academic"
            app:cornerRadius="12dp"
            app:icon="@android:drawable/ic_menu_sort_by_size"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@color/white"
            android:textColor="@color/white" />

    </LinearLayout>
</ScrollView>
